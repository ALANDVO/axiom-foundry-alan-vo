# Axiom Foundry - Environment Configuration
# Copy to .env and fill in values

# Database
DATABASE_URL=sqlite:///./axiom.db

# Keycloak (OIDC)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=axiom-foundry
KEYCLOAK_CLIENT_ID=axiom-frontend
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
PYTHONPATH=/app

# Frontend
VITE_API_BASE=http://localhost:8000/api
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=axiom-foundry
VITE_KEYCLOAK_CLIENT_ID=axiom-frontend

# LLM (Optional - for future AI features)
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Security
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30